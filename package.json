{
  "name": "dsh-plugin-workers-chat",
  "version": "1.0.0",
  "description": "DeepSeek Harness 桌面插件版 Workers Chat：保留分支消息树、五大内置插件、多服务商管理及纯本地离线 SQLite 存储",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "exports": {
    ".": "./dist-server/index.js",
    "./client": "./dist-client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-server",
    "dist-client",
    "migrations",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "package.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build:web": "vite build",
    "build:server": "esbuild src/server/cordis.ts --bundle --platform=node --format=esm --target=node20 --external:@deepseek-ai/* --banner:js=\"import { createRequire as __createRequire } from 'node:module'; import { fileURLToPath as __fileURLToPath } from 'node:url'; import { dirname as __pathDirname } from 'node:path'; const require = __createRequire(import.meta.url); const __filename = __fileURLToPath(import.meta.url); const __dirname = __pathDirname(__filename);\" --outfile=dist-server/index.js",
    "build:client": "esbuild src/client/dsh-client-entry.ts --bundle --format=iife --target=es2020 --outfile=dist-client/client.js",
    "build": "npm run build:web && npm run build:server && npm run build:client",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccawmiku/workers-chat.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "workers-chat",
    "ai-chat",
    "svelte-flow"
  ],
  "author": "",
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@lucide/svelte": "1.57.0",
    "@xyflow/svelte": "0.1.39",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "svelte": "5.57.2",
    "ws": "8.21.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.0",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.17",
    "daisyui": "5.7.50",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261012.0-beta",
    "svelte-check": "4.7.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true
}
