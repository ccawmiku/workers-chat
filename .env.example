# PUBLIC endpoint; real keys belong in the execution environment, never in Git.
UPSTREAM_BASE_URL=https://gemini.yaemiko.lol/v1
UPSTREAM_API_KEY=
# Test preference only: resolve the actual case-sensitive ID from /models.
TEST_OPENAI_MODEL=Gemini3.8flash-low
# Development / deployment secrets must be supplied separately.
APP_PASSWORD=
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
# Optional account-wide statistics. Production values are Worker secrets, never public Vite variables.
# Prefer an API token with Account Analytics Read restricted to the selected account.
CF_ANALYTICS_TOKEN=
CF_ANALYTICS_ACCOUNT_ID=
